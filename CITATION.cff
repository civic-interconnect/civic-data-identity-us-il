cff-version: "1.2.0"
message: "If you use this work, please cite it using the metadata in CITATION.cff."
type: software

title: "civic-data-identity-us-il"
version: "0.1.2"
date-released: "2026-10-22"

authors:
  - family-names: Case
    given-names: Denise M.
    orcid: "https://orcid.org/0000-0001-6165-7389"
    affiliation: "Northwest Missouri State University, School of Computer Science and Information Systems, Maryville, MO, USA"

repository-code: "https://github.com/civic-interconnect/civic-data-identity-us-il"
url: "https://github.com/civic-interconnect/civic-data-identity-us-il"

license: MIT

abstract: >
  This repository hosts raw and sampled Illinois datasets used for testing
  name normalization, deterministic identifier generation, and candidate record matching
  in the Civic Interconnect project. It includes a fixed snapshot of the
  City of Chicago Contracts dataset and curated subsets for SNFEI implementation testing,
  legal-name normalization, and candidate record matching experiments.

keywords:
  - civic data
  - identity resolution
  - procurement data
  - canonicalization
  - provenance
  - chicago open data
  - SNFEI
  - Illinois

references:
  # Upstream Chicago dataset (public-domain)
  - type: data
    title: "City of Chicago Contracts Dataset (public-domain)"
    authors:
      - name: "City of Chicago"
    year: 2025
    url: "https://data.cityofchicago.org/Administration-Finance/Contracts/rsxa-ify5"
    notes: >
      Upstream source for the raw procurement data contained in this repository.
      The City of Chicago remains the original data publisher. This repository
      redistributes a fixed snapshot strictly for research, identity testing,
      canonicalization, and reproducibility purposes within the Civic Interconnect
      ecosystem.
